{
  "name": "@scanoficus/elements",
  "version": "0.0.0",
  "description": "Framework-free custom elements for a VisionKit-style document scanner: camera, crop editor, review.",
  "license": "BSD-3-Clause",
  "author": "Julian Rath",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julian-r/scanoficus.git",
    "directory": "packages/elements"
  },
  "keywords": [
    "document-scanner",
    "custom-elements",
    "web-components",
    "pwa"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./src/define.ts"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "@scanoficus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "@scanoficus/source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@scanoficus/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

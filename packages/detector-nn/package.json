{
  "name": "@scanoficus/detector-nn",
  "version": "0.0.0",
  "description": "Optional neural document detector for scanoficus: DocQuadNet on a tiny WebGL2 runtime with a CPU fallback.",
  "license": "BSD-3-Clause",
  "author": "Julian Rath",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julian-r/scanoficus.git",
    "directory": "packages/detector-nn"
  },
  "keywords": [
    "document-scanner",
    "document-detection",
    "neural-network",
    "webgl2",
    "pwa"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/worker-entry.js",
    "./src/worker-entry.ts"
  ],
  "files": [
    "dist",
    "src",
    "models"
  ],
  "exports": {
    ".": {
      "@scanoficus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker-entry": {
      "@scanoficus/source": "./src/worker-entry.ts",
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.js"
    },
    "./models/*": "./models/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "check:browser": "node scripts/browser-check.mjs",
    "bench": "node scripts/browser-check.mjs --bench"
  },
  "peerDependencies": {
    "@scanoficus/core": ">=0.0.0"
  },
  "devDependencies": {
    "@scanoficus/core": "workspace:*",
    "@types/node": "26.6.6",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

{
  "name": "@scanoficus/core",
  "version": "0.0.0",
  "description": "Framework-agnostic document scanning core: edge detection, quad tracking, perspective correction and scan filters.",
  "license": "BSD-3-Clause",
  "author": "Julian Rath",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julian-r/scanoficus.git",
    "directory": "packages/core"
  },
  "keywords": [
    "document-scanner",
    "visionkit",
    "edge-detection",
    "perspective-correction",
    "pwa"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/worker-entry.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./detect": {
      "types": "./dist/detect.d.ts",
      "import": "./dist/detect.js"
    },
    "./warp": {
      "types": "./dist/warp.d.ts",
      "import": "./dist/warp.js"
    },
    "./filters": {
      "types": "./dist/filters.d.ts",
      "import": "./dist/filters.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./worker-entry": {
      "types": "./dist/worker-entry.d.ts",
      "import": "./dist/worker-entry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "eval": "node eval/run.ts"
  },
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@types/node": "26.6.6"
  }
}

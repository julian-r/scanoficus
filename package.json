{
  "name": "scanoficus-monorepo",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "size": "size-limit",
    "eval": "pnpm --filter @scanoficus/core eval",
    "bench:fetch": "pnpm --filter @scanoficus/core bench:fetch",
    "bench": "pnpm --filter @scanoficus/core bench",
    "bench:report": "pnpm --filter @scanoficus/core bench:report",
    "bench:montage": "pnpm --filter @scanoficus/core bench:montage",
    "bench:tune": "pnpm --filter @scanoficus/core bench:tune",
    "bench:import": "pnpm --filter @scanoficus/core bench:import",
    "dev:demo": "pnpm --filter @scanoficus/demo dev",
    "preview:demo": "pnpm --filter @scanoficus/demo preview",
    "check:browser": "node scripts/browser-check.mjs",
    "check:pack": "node scripts/pack-smoke.mjs",
    "check:nn": "pnpm --filter @scanoficus/detector-nn check:browser",
    "bench:nn": "pnpm --filter @scanoficus/detector-nn bench"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@size-limit/preset-small-lib": "14.3.0",
    "playwright-core": "1.65.0",
    "size-limit": "14.3.0",
    "typescript": "7.0.2"
  },
  "size-limit": [
    {
      "name": "@scanoficus/core (all exports)",
      "path": "packages/core/dist/index.js",
      "gzip": true,
      "limit": "40 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/controller",
      "path": "packages/core/dist/controller.js",
      "gzip": true,
      "limit": "25 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/detect",
      "path": "packages/core/dist/detect.js",
      "gzip": true,
      "limit": "10 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/render",
      "path": "packages/core/dist/render.js",
      "gzip": true,
      "limit": "10 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/warp",
      "path": "packages/core/dist/warp.js",
      "gzip": true,
      "limit": "5 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/filters",
      "path": "packages/core/dist/filters.js",
      "gzip": true,
      "limit": "5 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/pdf",
      "path": "packages/core/dist/pdf.js",
      "gzip": true,
      "limit": "3 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/camera",
      "path": "packages/core/dist/camera.js",
      "gzip": true,
      "limit": "3 KB",
      "import": "*"
    },
    {
      "name": "@scanoficus/core/worker-entry",
      "path": "packages/core/dist/worker-entry.js",
      "gzip": true,
      "limit": "10 KB"
    },
    {
      "name": "@scanoficus/elements (own code)",
      "path": "packages/elements/dist/index.js",
      "import": "*",
      "ignore": [
        "@scanoficus/core"
      ],
      "gzip": true,
      "limit": "12 KB"
    },
    {
      "name": "@scanoficus/elements/define (incl. core)",
      "path": "packages/elements/dist/define.js",
      "gzip": true,
      "limit": "40 KB"
    },
    {
      "name": "@scanoficus/react (own code)",
      "path": "packages/react/dist/index.js",
      "import": "*",
      "ignore": [
        "@scanoficus/core",
        "@scanoficus/elements",
        "react",
        "react/jsx-runtime"
      ],
      "gzip": true,
      "limit": "3 KB"
    },
    {
      "name": "@scanoficus/detector-nn (own code, without weights)",
      "path": "packages/detector-nn/dist/index.js",
      "import": "*",
      "ignore": [
        "@scanoficus/core"
      ],
      "gzip": true,
      "limit": "13 KB"
    },
    {
      "name": "@scanoficus/detector-nn/worker-entry (own code)",
      "path": "packages/detector-nn/dist/worker-entry.js",
      "ignore": [
        "@scanoficus/core"
      ],
      "gzip": true,
      "limit": "13 KB"
    }
  ]
}
